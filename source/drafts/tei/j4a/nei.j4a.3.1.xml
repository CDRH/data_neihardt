  <text>
    <body>
      
      <div1 type="letter">
        
        <pb facs="nei.j4a.3.1a" />

        <note type="curatorial">203 Neihardt Collection</note>
                                                                                                <fw type="curatorial">1</fw>

                                      <fw type="letterhead">
                                        <hi rend="caps">H. L. MENCKEN
                                                          <lb/>
                                                       1524 HOLLINS ST.
                                                          <lb/>
                                                         BALTIMORE.</hi>
                                      </fw>

        <opener>                                                                        
                                                                                        <dateline>March 25th.</dateline>


            <salute>My dear Neihardt: &#8212;</salute>
        </opener>
                <p>A pleasure, believe me!</p>

        <closer>
                        <salute>Ever,</salute>

                        <signed>H. L. Mencken.</signed>
        </closer>

      </div1>
      
      
      <div1 type="envelope">
        
        <pb facs="nei.j4a.3.1b"/>

        <ab type="return">
          <hi rend="caps">H. L. MENCKEN
            <lb/>
          1524 HOLLINS ST.
            <lb/>
          BALTIMORE.</hi>
        </ab>
        
        <ab type="postmark">BALTIMORE, MD. MAR 26 <unclear>1</unclear>030AM 1913
        2 D</ab>
        <figure>
          <figDesc>2 Cent Stamp</figDesc>
          <p>U.S.POSTAGE 2 CENTS 2</p>
        </figure>
        
                                <ab type="address">
                                  <address>
                                    <addrLine>John G. Neihardt,</addrLine>
                                    <addrLine>The <hi rend="underline"><title>Journal</title></hi>,</addrLine>
                                    <addrLine>Minneapolis, Minn.</addrLine>
                                  </address>
                                </ab>

        <note type="curatorial">Found in <hi rend="underline">H. L. Mencken</hi> &#8212; Roscoe, O'Sullivan and Henderson NY Alfred A. Knopf 1920</note>
          
      </div1>
    </body>
    
